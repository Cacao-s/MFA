{
  "contract": "mfa_core::platform::SyncProvider over HTTP, as implemented three times: android/…/sync/HttpProvider.kt, apple/Sources/Sync/HTTPProvider.swift, windows/MFA/Sync/HttpProvider.cs",
  "why": [
    "The same decision table is written once per platform, in three languages, and nothing but these vectors makes the three agree.",
    "The outcomes are not interchangeable. `absent` means 'be the first to write'; `lost_race` means 'fetch, merge and try again'; `error` means 'tell the user'. A target that reports a race as an error stops syncing silently, and one that reports an error as a race retries until it gives up.",
    "The self-hosted rows are checked against the real server in crates/mfa-sync-server/tests/conformance.rs, so this file cannot drift away from what the server actually answers."
  ],
  "outcomes": {
    "fetched": "the bytes and a revision",
    "absent": "nothing is there yet (null)",
    "lost_race": "somebody wrote first; re-read, merge, retry (null)",
    "written": "stored, with the new revision",
    "error": "throw, and let the coordinator report it"
  },
  "token": "conformance-token-not-a-real-one",
  "blob_base64": "TUZBU1lOQzEgb3BhcXVlIGNpcGhlcnRleHQsIG5vdCBhIHJlYWwgdmF1bHQ=",
  "blob_sha256_hex": "589eccba685311323eec69027e21ed7c8d40129bca76b7d5000c0be0f0084069",
  "cases": [
    {
      "id": "self_hosted/fetch/present",
      "flavour": "self_hosted",
      "operation": "fetch",
      "location": "https://sync.example.test",
      "name": "mfa-sync.vault",
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "url": "https://sync.example.test/v1/files/mfa-sync.vault",
            "headers": {
              "authorization": "Bearer conformance-token-not-a-real-one"
            }
          },
          "response": {
            "status": 200,
            "headers": {
              "etag": "\"9f8e7d6c\""
            },
            "body_base64": "TUZBU1lOQzEgb3BhcXVlIGNpcGhlcnRleHQsIG5vdCBhIHJlYWwgdmF1bHQ="
          }
        }
      ],
      "expect": {
        "outcome": "fetched",
        "revision": "9f8e7d6c",
        "body_base64": "TUZBU1lOQzEgb3BhcXVlIGNpcGhlcnRleHQsIG5vdCBhIHJlYWwgdmF1bHQ="
      },
      "note": "The ETag is the revision, with its quotes stripped. A client that keeps the quotes sends If-Match: \"\"9f8e7d6c\"\" and loses every race."
    },
