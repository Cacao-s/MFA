<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MFA.Views.AccountListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MFA.Views">

    <Grid RowSpacing="8" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left">
            <AppBarButton Icon="Add" Label="Add" Click="OnAddClick" />
            <AppBarButton x:Name="SyncButton" Icon="Sync" Label="Sync" Click="OnSyncClick" />
            <AppBarButton Icon="Setting" Label="Settings" Click="OnSettingsClick" />
            <AppBarButton Icon="Permissions" Label="Lock" Click="OnLockClick" />
        </CommandBar>

        <TextBox Grid.Row="1"
                 x:Name="SearchBox"
                 PlaceholderText="Search"
                 TextChanged="OnSearchChanged" />

        <ListView Grid.Row="2"
                  x:Name="Accounts"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnAccountClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:AccountRow">
                    <Grid ColumnSpacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind Spoken}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Subtitle}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Code}"
                                       FontFamily="Consolas"
                                       FontSize="24"
                                       IsTextSelectionEnabled="True" />
                        </StackPanel>

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ProgressRing Value="{x:Bind Progress}"
                                          IsIndeterminate="False"
                                          Width="34" Height="34" />
                            <TextBlock Text="{x:Bind Remaining}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Button Grid.Column="2"
                                VerticalAlignment="Center"
                                Content="&#xE712;"
                                FontFamily="Segoe Fluent Icons"
                                AutomationProperties.Name="More"
                                Tag="{x:Bind Id}"
                                Click="OnMoreClick" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2"
                    x:Name="EmptyState"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    Spacing="8">
            <TextBlock x:Name="EmptyTitle"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyBody"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar Grid.Row="3"
                 x:Name="StatusBar"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Informational" />
    </Grid>
</Page>
