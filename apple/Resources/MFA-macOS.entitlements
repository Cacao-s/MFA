<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Needed for the self-hosted server and the Git providers. Nothing
	     else goes out: there is no telemetry. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Reading a QR code from an image the user picks, and choosing a
	     sync folder. Read-only, and only what the user selects. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>

	<!-- A chosen sync folder stays reachable across launches. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>

	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.zeyanlin.mfa</string>
	</array>

	<!-- Deliberately absent: no camera, no microphone, no location, no
	     downloads folder, no server socket. -->
</dict>
</plist>
