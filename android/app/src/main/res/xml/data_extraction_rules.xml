<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through backup or device transfer. The vault's
     key lives in the Keystore and cannot be exported, so a copied vault file
     would be unreadable; excluding it keeps the ciphertext from travelling
     for no benefit. Moving device goes through the encrypted backup file or a
     sync target, both of which ask for the password. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
